<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true"
      throwExceptions="true"
      autoReload="true">

    <extensions>
        <add assembly="NLog.Appsettings.Standard" />
        <add assembly="NLog.Web.AspNetCore" />
        <add assembly="NLog.Loki" />
    </extensions>

    <variable name="utcTime" value="${date:format=yyyy-MM-dd HH\:mm\:ss.fff:universalTime=true}" />
    <variable name="logLevel" value="${uppercase:${level}:padding=-5}" />
    <variable name="logHead" value="${utcTime}|${right:${logger}:length=60:padding=-60}|${logLevel}" />
    <variable name="inlineMsg" value="${replace:inner=${message}:searchFor=\\r\\n|\\s:replaceWith= :regex=true}" />
    <variable name="rawMsg" value="${message}" />
    <variable name="allEventProps"
              value="${replace:inner=${all-event-properties:exclude=Title,Details}:searchFor=,:replaceWith=:regex=true:whenEmpty=No properties}" />
    <variable name="instanceId" value="InstanceId=${scope-property:instanceId:whenEmpty=0}" />
    <variable name="allScopeProps" value="${instanceId}" />
    <variable name="title" value="${event-properties:Title:whenEmpty=${inlineMsg}}" />
    <variable name="details" value="${event-properties:Details:whenEmpty=No details}" />
    <variable name="traceId" value="TraceId=${aspnet-TraceIdentifier:whenEmpty=0}" />
    <variable name="fullException" value="${exception:format=ToString}" />
    <variable name="inlineException"
              value="${replace:inner=${exception:format=ToString}:searchFor=\\r\\n|\\s:replaceWith= :regex=true}" />
    <variable name="shortInlineException"
              value="${onexception:${exception:format=shortType}\: ${exception:format=message}" />

    <targets>
        <target name="AllLogTargetConsole"
                xsi:type="ColoredConsole"
                useDefaultRowHighlightingRules="true"
                stdErr="true"
                layout="${logHead}|${inlineMsg}|${allScopeProps} ${allEventProps}|${details}|${traceId}|${inlineException}" />

        <target name="AllLogTarget"
                xsi:type="loki"
                endpoint="${appsettings:name=LoggingFeatures.Loki.Endpoint}"
                batchSize="100"
                taskDelayMilliseconds="1000"
                orderWrites="false"
                layout="${logHead} | ${inlineMsg} | ${allScopeProps} ${allEventProps} | ${details} | ${traceId} | ${shortInlineException} ">
            <label name="service" layout="MindTrail" />
            <label name="logtype" layout="All" />
        </target>

        <target name="ErrorsLogTarget"
                xsi:type="loki"
                endpoint="${appsettings:name=LoggingFeatures.Loki.Endpoint}"
                batchSize="100"
                taskDelayMilliseconds="1000"
                orderWrites="false"
                layout="${logHead} | ${rawMsg} | ${allScopeProps} ${allEventProps} | ${details} | ${traceId} | ${fullException} ">
            <label name="service" layout="MindTrail" />
            <label name="logtype" layout="Errors" />
        </target>

        <target name="StartupLogTarget"
                xsi:type="loki"
                endpoint="${appsettings:name=LoggingFeatures.Loki.Endpoint}"
                batchSize="100"
                taskDelayMilliseconds="1000"
                orderWrites="false"
                layout="${logHead} | ${inlineMsg} | ${instanceId} | No details | TraceId=0 | ${shortInlineException} ">
            <label name="service" layout="MindTrail" />
            <label name="logtype" layout="Startup" />
        </target>

        <target name="AppLogTarget"
                xsi:type="loki"
                endpoint="${appsettings:name=LoggingFeatures.Loki.Endpoint}"
                batchSize="100"
                taskDelayMilliseconds="1000"
                orderWrites="false"
                layout="${logHead} | ${title} | ${allScopeProps} ${allEventProps} | ${details} | ${traceId} | ${shortInlineException} ">
            <label name="service" layout="MindTrail" />
            <label name="logtype" layout="App" />
        </target>

        <target name="RequestsLogTarget"
                xsi:type="loki"
                endpoint="${appsettings:name=LoggingFeatures.Loki.Endpoint}"
                batchSize="100"
                taskDelayMilliseconds="1000"
                orderWrites="false"
                layout="${logHead} | ${inlineMsg} | ${instanceId} ${allEventProps} | No details | ${traceId} | ">
            <label name="service" layout="MindTrail" />
            <label name="logtype" layout="Requests" />
        </target>
    </targets>

    <rules>
        <logger name="*"
                minlevel="Error"
                writeTo="AllLogTarget, AllLogTargetConsole, ErrorsLogTarget"
                final="true" />

        <logger name="MindTrail.HostConfiguration.Logging.StartupLogger"
                minlevel="${appsettings:name=LoggingFeatures.NLog.MinLevels.StartupLogs}"
                writeTo="AllLogTarget, AllLogTargetConsole, StartupLogTarget"
                final="true" />

        <logger name="MindTrail.AppServices"
                minlevel="${appsettings:name=LoggingFeatures.NLog.MinLevels.AppLogs}"
                writeTo="AllLogTarget, AllLogTargetConsole, AppLogTarget"
                final="true" />

        <logger name="Microsoft.EntityFrameworkCore.*"
                minlevel="${appsettings:name=LoggingFeatures.NLog.MinLevels.EfCoreLogs}"
                writeTo="AllLogTarget, AllLogTargetConsole"
                final="true" />

        <logger name="Microsoft.AspNetCore.HttpLogging.*"
                minlevel="${appsettings:name=LoggingFeatures.NLog.MinLevels.RequestLogs}"
                writeTo="AllLogTarget, AllLogTargetConsole, RequestsLogTarget">

            <filters defaultAction="Log">
                <when condition="contains('${aspnet-Request-Url}','health')" action="Ignore" />
                <when condition="equals(message,'Response:${newline}')" action="Ignore" />
            </filters>
        </logger>

        <logger name="*"
                minlevel="${appsettings:name=LoggingFeatures.NLog.MinLevels.OtherLogs}"
                writeTo="AllLogTarget, AllLogTargetConsole" />
    </rules>
</nlog>