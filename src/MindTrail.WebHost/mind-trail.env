CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=host.docker.internal; Port=5432; Database=MindTrailDb; Username=postgres; Password=postgres;

APP__APIKEY=ApiKey
APP__ADDITIONALAPIKEYS=

EFCORE__DATABASEPROVIDER=Postgresql
EFCORE__APPLYMIGRATIONSAUTOMATICALLY=false
EFCORE__ENABLESENSITIVEDATALOGGING=false

LOGGINGFEATURES__HTTPLOGGING__REQUESTHEADERS=false
LOGGINGFEATURES__HTTPLOGGING__REQUESTPROTOCOL=true
LOGGINGFEATURES__HTTPLOGGING__REQUESTSCHEME=true
LOGGINGFEATURES__HTTPLOGGING__REQUESTMETHOD=true
LOGGINGFEATURES__HTTPLOGGING__REQUESTPATH=true
LOGGINGFEATURES__HTTPLOGGING__REQUESTQUERY=true
LOGGINGFEATURES__HTTPLOGGING__REQUESTBODY=false
LOGGINGFEATURES__HTTPLOGGING__RESPONSEHEADERS=true
LOGGINGFEATURES__HTTPLOGGING__RESPONSESTATUSCODE=true
LOGGINGFEATURES__HTTPLOGGING__RESPONSEBODY=false

LOGGINGFEATURES__NLOG__CONFIGFILE=NLog.config
LOGGINGFEATURES__NLOG__MINLEVELS__STARTUPLOGS=Debug
LOGGINGFEATURES__NLOG__MINLEVELS__APPLOGS=Debug
LOGGINGFEATURES__NLOG__MINLEVELS__REQUESTLOGS=Info
LOGGINGFEATURES__NLOG__MINLEVELS__EFCORELOGS=Warn
LOGGINGFEATURES__NLOG__MINLEVELS__OTHERLOGS=Warn

LOGGINGFEATURES__LOKI__ENDPOINT=http://localhost:3100

ASPNETCORE_HTTP_PORTS=8080

ALLOWEDHOSTS=*