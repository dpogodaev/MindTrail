    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MindTrail.Common\MindTrail.Common.csproj" />
        <ProjectReference Include="..\MindTrail.DomainServices\MindTrail.DomainServices.csproj"/>
    </ItemGroup>

</Project>
